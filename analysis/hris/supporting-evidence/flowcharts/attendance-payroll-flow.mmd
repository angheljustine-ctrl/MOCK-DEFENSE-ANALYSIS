flowchart TD
    A([Start attendance]) --> B{Input source?}
    B -- Fingerprint/demo --> C[/Fingerprint ID scan/]
    B -- Manual --> D[/Employee, date, time-in, optional time-out/]
    C --> E{Existing employee/date record?}
    E -- No --> F[Insert time-in]
    E -- Yes, no time-out --> G[Update time-out]
    E -- Yes, complete --> H[/Warn already completed/]
    D --> I{Required fields and time order valid?}
    I -- No --> J[/Show validation error/]
    J --> D
    I -- Yes --> K[Insert record without duplicate check]
    F --> L[(attendance localStorage)]
    G --> L
    K --> L
    L --> M[Filter period records]
    M --> N[daysPresent = count of records with timeIn]
    N --> O[Basic pay = daily rate x daysPresent]
    O --> P[/Show payroll draft/]
    P --> Q{Finalize?}
    Q -- No --> R([End without save])
    Q -- Yes --> S[(Replace payroll records for period)]
    S --> T([Payslip/history])
