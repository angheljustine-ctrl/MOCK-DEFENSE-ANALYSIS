flowchart TD
    A([Start]) --> B[/Enter username and password/]
    B --> C[Read admins and teachers from browser localStorage]
    C --> D{Account found?}
    D -- No --> E[/Show account-not-found error/]
    E --> B
    D -- Yes --> F{Password matches and status active?}
    F -- No --> G[/Show password or inactive error/]
    G --> B
    F -- Yes --> H{Role?}
    H -- Admin --> I[Open Admin Dashboard]
    H -- Teacher --> J[Open Teacher Dashboard]
    I --> K[Manage accounts, academic data, reviews, reports]
    J --> L[Manage sections, students, attendance, class records]
    K --> M[(Browser localStorage)]
    L --> M
    M --> N[/Render dashboard state/]
    N --> O([End / continue session])
