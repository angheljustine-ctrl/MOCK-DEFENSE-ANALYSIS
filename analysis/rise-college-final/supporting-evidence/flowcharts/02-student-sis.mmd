flowchart TD
    A([Start]) --> B[/Open student.html/]
    B --> C{Session exists?}
    C -- No --> D[Create local student session automatically]
    C -- Yes --> E{Role is student?}
    D --> F[(Browser localStorage session)]
    F --> G{SIS record complete?}
    E -- No --> H[/Redirect to public home/]
    E -- Yes --> G
    G -- No --> I[/Enter SIS information/]
    I --> J{Required fields present?}
    J -- No --> K[/Browser or toast error/]
    K --> I
    J -- Yes --> L[(Save per-account SIS record and shared registry)]
    L --> M[Update local session]
    M --> N[/Show dashboard/]
    G -- Yes --> N
    N --> O{Open profile?}
    O -- No --> P([Continue using portal])
    O -- Yes --> Q[Build profile with innerHTML]
    Q --> R{Stored value contains markup?}
    R -- Yes --> S[/Browser interprets it as live HTML/]
    R -- No --> T[/Display student data/]
    H --> U([End])
    S --> U
    T --> U
